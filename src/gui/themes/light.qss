/* ==========================
   Main Window
========================== */

QMainWindow {
    background-color: #F5F7FA;
}


/* ==========================
   GroupBox
========================== */

QGroupBox {
    color: #1F2937;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    margin-top: 12px;
    font-weight: bold;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}


/* ==========================
   Labels
========================== */

QLabel {
    color: #1F2937;
}


/* ==========================
   Buttons
========================== */

QPushButton {

    background-color: #2962FF;
    color: white;

    border: none;
    border-radius: 6px;

    padding: 8px;
    min-width: 80px;
    min-height: 30px;
}

QPushButton:hover {

    background-color: #448AFF;

}

QPushButton:pressed {

    background-color: #1E4ED8;

}

QPushButton:disabled {

    background-color: #D1D5DB;
    color: #6B7280;

}


/* ==========================
   ComboBox
========================== */

QComboBox {

    background-color: white;

    color: #1F2937;

    border: 1px solid #C7CDD4;

    border-radius: 5px;

    padding: 5px;

}

QComboBox:hover {

    border: 1px solid #2962FF;

}

QComboBox QAbstractItemView {

    background: white;

    color: #1F2937;

    selection-background-color: #2962FF;

    selection-color: white;

}


/* ==========================
   Plain Text
========================== */

QPlainTextEdit {

    background: white;

    color: #111827;

    border: 1px solid #D1D5DB;

}


/* ==========================
   ScrollBar
========================== */

QScrollBar:vertical {

    background: #F3F4F6;
    width: 10px;
    margin: 0px;

}

QScrollBar::handle:vertical {

    background: #C4C4C4;
    border-radius: 5px;

}

QScrollBar::handle:vertical:hover {

    background: #9CA3AF;

}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {

    height: 0px;

}


/* ==========================
   ToolTip
========================== */

QToolTip {

    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    padding: 4px;

}
/* ==========================
   Main Window
========================== */

QMainWindow {
    background-color: #202124;
}


/* ==========================
   GroupBox
========================== */

QGroupBox {
    color: white;
    border: 1px solid #444;
    border-radius: 8px;
    margin-top: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}


/* ==========================
   Labels
========================== */

QLabel {
    color: white;
}


/* ==========================
   Buttons
========================== */

QPushButton {

    background-color: #2962FF;
    color: white;

    border: none;
    border-radius: 6px;

    padding: 8px;
    min-width: 80px;
    min-height: 30px;

}

QPushButton:pressed {

    background-color: #1E4ED8;

}

QPushButton:hover {

    background-color: #448AFF;

}

QPushButton:disabled {

    background-color: #555;
    color: #AAA;

}


/* ==========================
   ComboBox
========================== */

QComboBox {

    background-color: #2D2D30;

    color: white;

    border: 1px solid #555;

    border-radius: 5px;

    padding: 5px;

}

QComboBox QAbstractItemView {

    background: #2D2D30;

    color: white;

}


/* ==========================
   Plain Text
========================== */

QPlainTextEdit {

    background: #181818;

    color: #00FF88;

    border: 1px solid #444;

}
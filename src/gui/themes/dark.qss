* {
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow, QWidget#appRoot { background: #0f1420; color: #eef2f8; }
QLabel { color: #eef2f8; background: transparent; }

QFrame#appHeader { background: #171f2e; border: 1px solid #2d3a4f; border-radius: 12px; }
QLabel#appTitle { font-size: 15pt; font-weight: 700; color: #f8fafc; }
QLabel#appSubtitle, QLabel#mutedLabel { color: #9eacc0; font-size: 9pt; }
QLabel#fieldLabel { color: #c8d2e2; font-size: 9pt; font-weight: 600; }
QLabel#panelTitle { font-size: 12pt; font-weight: 700; color: #f8fafc; }

QPushButton {
    min-height: 24px;
    padding: 7px 10px;
    border: 1px solid #3b4960;
    border-radius: 7px;
    color: #e5ebf4;
    background: #1b2535;
    font-weight: 600;
}
QPushButton:hover { border-color: #6f91f2; background: #243149; }
QPushButton:pressed { background: #2b3a54; }
QPushButton:disabled { color: #66758b; border-color: #2a3547; background: #18202d; }

QPushButton#primaryButton { min-height: 30px; border-color: #5a7cff; color: #ffffff; background: #4969e8; font-weight: 700; }
QPushButton#primaryButton:hover { background: #5b7af0; }
QPushButton#primaryButton:disabled { background: #34436c; border-color: #34436c; color: #8290ab; }
QPushButton#secondaryButton { background: #1b2535; color: #dce5f2; }
QPushButton#tertiaryButton { border-color: transparent; background: transparent; color: #bcc8d9; }
QPushButton#tertiaryButton:hover { border-color: #3b4960; background: #202b3d; }
QPushButton#iconButton { min-width: 30px; max-width: 34px; min-height: 28px; padding: 2px; border-color: transparent; background: transparent; font-size: 13pt; }
QPushButton#segmentButton { border-radius: 6px; background: #202b3d; }
QPushButton#segmentButton:checked { color: #ffffff; border-color: #6686ff; background: #4969e8; }

QLabel#statusBadge { padding: 5px 9px; border: 1px solid #40506a; border-radius: 10px; color: #b8c4d6; background: #1b2535; font-size: 9pt; font-weight: 700; }
QLabel#statusBadge[statusState="ready"] { color: #75e0a7; border-color: #1f6f50; background: #12362b; }
QLabel#statusBadge[statusState="running"] { color: #84adff; border-color: #3157a3; background: #172d57; }
QLabel#statusBadge[statusState="paused"] { color: #fec84b; border-color: #895b16; background: #3f2d12; }
QLabel#statusBadge[statusState="finished"] { color: #bdb4fe; border-color: #5d4ca4; background: #2d2454; }

QFrame#alertBanner { border: 1px solid #3157a3; border-radius: 9px; background: #172d57; }
QFrame#alertBanner[alertLevel="success"] { border-color: #1f6f50; background: #12362b; }
QFrame#alertBanner[alertLevel="error"] { border-color: #912f38; background: #461c22; }

QScrollArea, QWidget#sidebarContent, QWidget#workspace { border: none; background: transparent; }
QScrollArea#sidebarScroll { border: 1px solid #2d3a4f; border-radius: 12px; background: #131b28; }

QGroupBox { margin-top: 10px; padding-top: 8px; border: 1px solid #2d3a4f; border-radius: 10px; background: #171f2e; color: #dbe4f0; font-weight: 700; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }

QComboBox#fieldInput { min-height: 26px; padding: 5px 28px 5px 9px; border: 1px solid #3b4960; border-radius: 7px; color: #eef2f8; background: #111925; selection-background-color: #344c91; }
QComboBox#fieldInput:hover, QComboBox#fieldInput:focus { border-color: #6686ff; }
QComboBox#fieldInput:disabled { color: #66758b; background: #18202d; }
QComboBox QAbstractItemView { padding: 4px; border: 1px solid #3b4960; color: #eef2f8; background: #171f2e; selection-color: #ffffff; selection-background-color: #4969e8; }
QListWidget#goalList { padding: 4px; border: 1px solid #3b4960; border-radius: 7px; color: #eef2f8; background: #111925; alternate-background-color: #171f2e; selection-color: #ffffff; selection-background-color: #4969e8; }
QListWidget#goalList:disabled { color: #66758b; background: #18202d; }
QCheckBox { color: #dbe4f0; spacing: 7px; }
QCheckBox:disabled { color: #66758b; }

QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: #31415b; }
QSplitter#mainSplitter::handle:horizontal { width: 10px; margin: 0 2px; border-left: 1px solid #35445b; border-right: 1px solid #35445b; background: #28364a; }
QSplitter#mainSplitter::handle:horizontal:hover, QSplitter#mainSplitter::handle:horizontal:pressed { border-color: #6686ff; background: #3f5795; }
QSplitter#visualizationSplitter::handle:horizontal { width: 10px; margin: 0 2px; border-left: 1px solid #35445b; border-right: 1px solid #35445b; background: #28364a; }
QSplitter#visualizationSplitter::handle:horizontal:hover, QSplitter#visualizationSplitter::handle:horizontal:pressed { border-color: #6686ff; background: #3f5795; }
QSplitter#visualizationSplitter::handle:vertical, QSplitter#workspaceSplitter::handle:vertical { height: 7px; }

QWebEngineView#mapView, QWebEngineView#graphView { border: 1px solid #3b4960; border-radius: 10px; background: #dfe7f0; }
QFrame#algorithmStatePanel { border: 1px solid #2d3a4f; border-radius: 10px; background: #171f2e; }
QFrame#currentNodeCard { border: 1px solid #895b16; border-radius: 9px; background: #3a2b15; }
QLabel#currentNodeValue { color: #fec84b; font-size: 18pt; font-weight: 800; }
QFrame#metricStrip, QFrame#stateList { border: 1px solid #2f3c50; border-radius: 8px; background: #111925; }
QLabel#stateListTitle, QLabel#metricTitle { color: #9eacc0; font-size: 8pt; font-weight: 700; }
QLabel#stateListValue { color: #dbe4f0; font-size: 9pt; }
QLabel#stateMetricValue { color: #84adff; font-size: 11pt; font-weight: 700; }
QPushButton#stateDetailsButton { min-height: 18px; padding: 2px 6px; border-color: transparent; color: #84adff; background: transparent; font-size: 8pt; }
QPushButton#stateDetailsButton:hover { border-color: #3f5795; background: #202d45; }
QTextEdit#stateDetails { padding: 5px; border: 1px solid #35445b; border-radius: 6px; color: #d7e0ed; background: #111925; font-family: "Cascadia Mono", "Consolas"; font-size: 9pt; }

QTabWidget#infoTabs::pane { border: 1px solid #2d3a4f; border-radius: 9px; background: #171f2e; top: -1px; }
QTabWidget#infoTabs QTabBar::tab { min-width: 72px; padding: 8px 12px; border: 1px solid transparent; color: #9eacc0; background: transparent; }
QTabWidget#infoTabs QTabBar::tab:selected { color: #84adff; border-bottom-color: #6686ff; font-weight: 700; }
QTabWidget#infoTabs QTabBar::tab:hover { color: #b2c7ff; background: #202b3d; }

QGroupBox#resultSummary { border: none; border-radius: 0; background: #171f2e; }
QFrame#metricCard { border: 1px solid #2f3c50; border-radius: 9px; background: #111925; }
QLabel#metricValue { color: #f8fafc; font-size: 13pt; font-weight: 800; }
QLabel#resultStatus { padding: 4px 9px; border-radius: 9px; font-weight: 700; }
QLabel#resultStatus[resultState="idle"] { color: #b8c4d6; background: #263246; }
QLabel#resultStatus[resultState="running"] { color: #84adff; background: #172d57; }
QLabel#resultStatus[resultState="success"] { color: #75e0a7; background: #12362b; }
QLabel#resultStatus[resultState="error"] { color: #fda29b; background: #461c22; }
QLabel#routeText { color: #d7e0ed; font-weight: 600; }
QTableWidget#routeTable { border: 1px solid #2f3c50; border-radius: 7px; color: #d7e0ed; background: #111925; alternate-background-color: #171f2e; gridline-color: #2f3c50; }
QTableWidget#routeTable QHeaderView::section { padding: 6px; border: none; border-bottom: 1px solid #2f3c50; color: #bcc8d9; background: #202b3d; font-weight: 700; }

QTextEdit#eventLog { padding: 9px; border: none; color: #c9d5e6; background: #111925; font-family: "Cascadia Mono", "Consolas"; font-size: 9pt; selection-background-color: #344c91; }

QScrollBar:vertical { width: 10px; margin: 2px; border: none; background: transparent; }
QScrollBar::handle:vertical { min-height: 28px; border-radius: 4px; background: #40506a; }
QScrollBar::handle:vertical:hover { background: #536680; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { padding: 5px; border: 1px solid #3b4960; color: #eef2f8; background: #171f2e; }
